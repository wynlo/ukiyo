{
  "project": {
    "name": "Neon Alley",
    "description": "Night-market street vendor sim in a rainy cyberpunk city, run by cats."
  },
  "style": {
    "file": "art/style.md",
    "additionalDetails": ""
  },
  "manifest": "art/manifest.json",
  "out": "art/generated",
  "provider": {
    "name": "codex",
    "concurrency": 1,
    "gapMs": 6000,
    "model": "gpt-image-2",
    "effort": "low",
    "timeoutMs": 420000
  },
  "cutout": {
    "mode": "chroma",
    "chroma": "#00FF00",
    "threshold": 102,
    "feather": 1.5,
    "despill": true,
    "detectThreshold": 34,
    "minArea": 400,
    "mergeGap": 14
  },
  "atlas": {
    "dir": "atlas",
    "groupBy": "game",
    "scale": 2,
    "unit": 64,
    "format": "phaser-hash",
    "padding": 8,
    "maxSize": 4096,
    "quantize": false,
    "pot": true,
    "groupScale": {}
  },
  "kinds": {
