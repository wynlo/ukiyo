{
  "project": {
    "name": "Zen Garden",
    "description": "Calm garden builder: place stones, ponds and trees and watch frogs, koi and cranes visit."
  },
  "style": {
    "file": "art/style.md",
    "additionalDetails": ""
  },
  "manifest": "art/manifest.json",
  "out": "art/generated",
  "provider": {
    "name": "codex",
    "concurrency": 1,
    "gapMs": 6000,
    "model": "gpt-image-2",
    "effort": "low",
    "timeoutMs": 420000
  },
  "cutout": {
    "mode": "flood",
    "chroma": "#00FF00",
    "threshold": 102,
    "feather": 1.5,
    "despill": true,
    "detectThreshold": 34,
    "minArea": 400,
    "mergeGap": 14
  },
  "atlas": {
    "dir": "atlas",
    "groupBy": "game",
    "scale": 2,
    "unit": 64,
    "format": "phaser-hash",
    "padding": 8,
    "maxSize": 4096,
    "quantize": false,
    "pot": true,
    "groupScale": {}
  },
  "kinds": {
    "backdrop": {
      "width": 8,
      "anchor": "top-left",
      "aspect": "1:1"
    },
    "furniture": {
      "height": 2,
      "anchor": "bottom-center",
      "aspect": "2:1"
    },
    "furniture-wide": {
      "height": 1.75,
      "anchor": "bottom-center",
      "aspect": "2:1"
    },
    "scenery": {
      "height": 2.25,
      "anchor": "bottom-center",
      "aspect": "3:2"
    },
    "gate": {
      "height": 4,
      "anchor": "bottom-center",
      "aspect": "2:3"
    },
    "visitor": {
      "height": 1.5,
      "anchor": "bottom-center",
      "aspect": "1:1"
    },
    "item": {
      "height": 0.75,
      "anchor": "center",
      "aspect": "1:1"
    },
    "icon": {
      "height": 0.5,
      "anchor": "center",
      "aspect": "1:1"
    },
    "fx": {
      "height": 0.75,
      "anchor": "bottom-center",
      "aspect": "1:1"
    },
    "critter": {
      "height": 0.7,
      "anchor": "bottom-center",
      "aspect": "1:1"
    },
    "bar": {
      "height": 0.3,
      "anchor": "center",
      "aspect": "3:1"
    },
    "key-art": {
      "width": 15,
      "anchor": "top-left",
      "aspect": "2:1"
    }
  },
  "tints": {},
  "references": {
    "anchors": [],
    "firstTarget": true,
    "auto": {
      "max": 2,
      "match": [
        "kind"
      ]
    }
  }
}
