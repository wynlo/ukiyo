    "groups": [
      "shrine",
      "shrine-features",
      "shrine-scenery",
      "shrine-interior",
      "shrine-interior-features",
      "shrine-matsuri-features",
      "shrine-matsuri-ui",
      "shrine-onsen-features",
      "shrine-onsen-ui",
      "shrine-onsen",
      "critters-staff",
      "shrine-staff-ui",
      "shrine-haiden",
      "shrine-hall-tiers",
      "shrine-haiden-grand",
      "shrine-sando",
      "shrine-altar",
      "shrine-altar-statues",
      "shrine-matsuri-edge",
      "shrine-onsen-edge"
    ],
    "notes": "Art brief: follow docs/specs/art-bible.md (LOCKED Meow Tower style) and match docs/references/style-anchor.png. Lineless, soft cel shading, warm cheerful palette, chunky pillowy shapes. Keep the approved sprite exactly as it is.",
    "triggers": [
      {
        "match": "^matsuri-edge/game-stall-back",
        "material": "awning"
      },
      {
        "match": "^matsuri-edge/yatai-cart",
        "material": "paper"
      },
      {
        "match": "^onsen-edge/changing-hut",
        "material": "paper"
      },
      {
        "match": "^onsen-[a-z]+/(chochin-post)|^onsen-gate|^onsen-bathhouse",
        "material": "lantern"
      },
      {
        "match": "^onsen-[a-z]+/(noren-gate|sudare-screen|towel-rack)|^onsen-gate|^onsen-bathhouse",
        "material": "paper"
      },
      {
        "match": "^onsen-[a-z]+/(nuru-yu|yuzu-tub|ashiyu|hinoki-buro|tamago-basket)|^onsen-rotenburo",
        "material": "water"
      },
      {
        "match": "^onsen-[a-z]+/(fern-clump|sasa-clump|hagi-bush)",
        "material": "canopy"
      },
      {
        "match": "^matsuri-[a-z]+/(chochin-pole|lantern-line|hono-chochin|lantern-mast)|^matsuri-gate|^matsuri-yagura",
        "material": "lantern"
      },
      {
        "match": "^matsuri-[a-z]+/(nobori-banners|festival-banner)",
        "material": "streamer"
      },
      {
        "match": "^matsuri-yatai/|^matsuri-[a-z]+/(shateki|stall-back)",
        "material": "awning"
      },
      {
        "match": "^matsuri-[a-z]+/kingyo",
        "material": "water"
      },
      {
        "match": "^shrine-int-[a-z]+/(candle)",
        "material": "flame"
      },
      {
        "match": "^shrine-int-[a-z]+/(bonbori|tsuri-doro|tall-andon)|^shrine-int-altar",
        "material": "light"
      },
      {
        "match": "^shrine-int-[a-z]+/suzu",
        "material": "bell"
      },
      {
        "match": "^shrine-int-[a-z]+/(kagura-stage|ogi-stand)",
        "material": "fan"
      },
      {
        "match": "^shrine-int-[a-z]+/(omikuji|ema|omamori|sakaki|tamagushi)",
        "material": "loose"
      },
      {
        "match": "lantern|chochin|toro|andon|firefly",
        "material": "light"
      },
      {
        "match": "tree|sapling|planter|bonsai|bush|bamboo|pine|maple|sakura|momiji|camellia",
        "material": "canopy"
      },
      {
        "match": "banner|flag|noren|streamer|koinobori|shide|shimenawa|tanabata|omikuji|ema",
        "material": "paper"
      },
      {
        "match": "bell|chime|furin",
        "material": "hanging"
      },
      {
        "match": "candle|torch|flame",
        "material": "flame"
      },
      {
        "match": "basin|fountain|well|pond|bird-bath|tsukubai|chozuya|bucket|shishi",
        "material": "water"
      },
      {
        "match": "pinwheel|windmill|wheel|yatai|cart",
        "material": "blade"
      },
      {
        "match": "offering-box|coin|stall|omamori",
        "material": "loose"
      },
      {
        "match": "reed|grass|pampas|tsukimi|kadomatsu",
        "material": "stem"
      }
    ],
    "exclude": [
      "^shrine-(icons|items|ground|pond|courtyard|lawn-bg)/"
    ],
    "lights": {
      "match": "lantern|chochin|toro|andon|firefly|candle|haiden|bonbori|doro|int-altar|takoyaki|taiyaki|yakisoba|ringo-ame|yagura|matsuri-gate|onsen-gate|onsen-bathhouse|yatai-cart|changing-hut",
      "lit": {
        "minValue": 0.9,
        "hue": [
          35,
          75
        ],
        "minSat": 0.25,
        "core": {
          "maxSat": 0.35,
          "minValue": 0.95
        }
      },
      "body": {
        "minValue": 0.72
      },
      "open": 1,
      "minArea": 8,
      "minThick": 4,
      "minShare": 0.15
    },
    "wind": {
      "materials": [
        "paper",
        "chime",
        "streamer",
        "hanging",
        "lantern",
        "stem",
        "canopy",
        "blade",
        "awning"
      ]
    }
  }
