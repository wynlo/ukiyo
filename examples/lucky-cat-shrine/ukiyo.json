        "lag": 120,
        "rest": {
          "kind": "swing",
          "amount": [
            0.8,
            1.3
          ],
          "periodMs": [
            3000,
            4200
          ]
        },
        "use": {
          "kind": "swing",
          "amount": [
            2.5,
            4.5
          ],
          "periodMs": [
            600,
            900
          ],
          "durationMs": [
            1600,
            2400
          ]
        },
        "gust": {
