{
  "name": "ukiyo",
  "version": "0.1.0",
  "description": "Game art pipeline CLI: per-project style file, prompt composer, image generation, cut-out, frame strips, review gate, atlas packing.",
  "type": "module",
  "license": "MIT",
  "author": "Wayne Loh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wynlo/ukiyo.git"
  },
  "homepage": "https://github.com/wynlo/ukiyo#readme",
  "bugs": {
    "url": "https://github.com/wynlo/ukiyo/issues"
  },
  "keywords": [
    "sprites",
    "texture-atlas",
    "game-art",
    "phaser",
    "image-generation",
    "cli"
  ],
  "bin": {
    "ukiyo": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "tsx fixtures/make.ts",
    "check:refs": "tsx fixtures/references.ts",
    "check:plan": "tsx fixtures/plan.ts",
    "showcase": "tsx scripts/showcase.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "handlebars": "^4.7.9",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "maxrects-packer": "^2.7.3",
    "open": "^11.0.4",
    "react": "^19.3.0",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
